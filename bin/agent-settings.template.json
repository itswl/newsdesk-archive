{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read({{HOME}}/.oci/**)",
      "Read({{HOME}}/.ssh/**)",
      "Read({{HOME}}/.aws/**)",
      "Read({{HOME}}/.config/gh/**)",
      "Read({{HOME}}/.codex/**)",
      "Read({{HOME}}/.claude/**)",
      "Read({{HOME}}/.gnupg/**)",
      "Read({{HOME}}/.netrc)",
      "Read({{HOME}}/.npmrc)",
      "Read({{HOME}}/Library/Keychains/**)",
      "Bash(git push:*)",
      "Bash(gh repo:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(oci:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(security:*)",
      "Bash(sudo:*)",
      "Bash(launchctl:*)",
      "Bash(crontab:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [],
      "strictAllowlist": true,
      "allowLocalBinding": false
    },
    "filesystem": {
      "denyRead": [
        "{{HOME}}/.oci",
        "{{HOME}}/.ssh",
        "{{HOME}}/.aws",
        "{{HOME}}/.config/gh",
        "{{HOME}}/.codex",
        "{{HOME}}/.claude",
        "{{HOME}}/.gnupg",
        "{{HOME}}/.docker",
        "{{HOME}}/.netrc",
        "{{HOME}}/.npmrc",
        "{{HOME}}/Library/Keychains",
        "{{HOME}}/Library/Application Support/Google",
        "{{HOME}}/Library/Cookies"
      ],
      "allowWrite": [
        "{{ROOT}}"
      ],
      "denyWrite": [
        "{{ROOT}}/bin",
        "{{ROOT}}/.git"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "{{HOME}}/.oci/oci_api_key.pem",
          "mode": "deny"
        },
        {
          "path": "{{HOME}}/.config/gh/hosts.yml",
          "mode": "deny"
        },
        {
          "path": "{{HOME}}/.codex/config.toml",
          "mode": "deny"
        }
      ]
    }
  },
  "disableAllHooks": true,
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "_comment": "运行时模板：{{HOME}} 与 {{ROOT}} 由 bin/run_task.sh 替换后渲染到 state/agent-settings.json。不要直接把这个文件传给 --settings。"
}